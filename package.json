{
	"name": "retirement-planner",
	"version": "0.0.1",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build:wasm": "cd rust-engine && wasm-pack build --target web",
		"dev": "pnpm run build:wasm && vite dev",
		"build": "pnpm run build:wasm && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"data:retirement:import": "node scripts/import-retirement-market-data.mjs",
		"data:retirement:preprocess": "node scripts/preprocess-retirement-market-data.mjs",
		"data:retirement:refresh": "pnpm run data:retirement:import && pnpm run data:retirement:preprocess"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "2.69.1",
		"svelte": "5.56.4"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.69.1",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/postcss": "4.3.2",
		"@types/node": "26.1.0",
		"@vitest/browser-playwright": "4.1.10",
		"esbuild": "0.28.1",
		"eslint": "10.6.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.20.0",
		"globals": "17.7.0",
		"playwright": "1.61.1",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.21",
		"rollup": "4.62.2",
		"rust-engine": "file:rust-engine/pkg",
		"svelte": "5.56.4",
		"svelte-check": "4.7.2",
		"tailwindcss": "4.3.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.63.0",
		"vite": "8.1.3",
		"vite-plugin-top-level-await": "1.6.0",
		"vite-plugin-wasm": "3.6.0",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "2.2.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"plotly.js-dist-min": "3.7.0"
	}
}
