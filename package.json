{
	"name": "retirement-planner",
	"version": "0.0.1",
	"description": "Browser-based FIRE retirement planner: regime-switching Monte Carlo simulation with historical block bootstrapping, running in a Rust/WebAssembly engine.",
	"license": "AGPL-3.0-only",
	"author": "Sergey Farin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sergeyfarin/retirement-planner.git"
	},
	"homepage": "https://github.com/sergeyfarin/retirement-planner#readme",
	"bugs": {
		"url": "https://github.com/sergeyfarin/retirement-planner/issues"
	},
	"keywords": [
		"retirement",
		"fire",
		"monte-carlo",
		"financial-independence",
		"svelte",
		"webassembly"
	],
	"private": true,
	"packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
	"scripts": {
		"build:wasm": "cd rust-engine && wasm-pack build --target web",
		"dev": "pnpm run build:wasm && vite dev",
		"build": "pnpm run build:wasm && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"data:retirement:import": "node scripts/import-retirement-market-data.mjs",
		"data:retirement:preprocess": "node scripts/preprocess-retirement-market-data.mjs",
		"data:retirement:refresh": "pnpm run data:retirement:import && pnpm run data:retirement:preprocess",
		"test:engines": "vitest run --project server"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.1.1",
		"@vitest/browser-playwright": "4.1.10",
		"esbuild": "0.28.1",
		"eslint": "10.7.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.7.0",
		"playwright": "1.61.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.21",
		"rollup": "4.62.2",
		"rust-engine": "file:rust-engine/pkg",
		"svelte": "5.56.7",
		"svelte-check": "4.7.3",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vite-plugin-top-level-await": "1.6.0",
		"vite-plugin-wasm": "3.6.0",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "3.0.0"
	},
	"dependencies": {
		"plotly.js-dist-min": "3.7.0"
	}
}
