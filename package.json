{
	"name": "retirement-planner",
	"version": "0.0.1",
	"description": "Browser-based FIRE retirement planner: regime-switching Monte Carlo simulation with historical block bootstrapping, running in a Rust/WebAssembly engine.",
	"license": "AGPL-3.0-only",
	"author": "Sergey Farin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sergeyfarin/retirement-planner.git"
	},
	"homepage": "https://github.com/sergeyfarin/retirement-planner#readme",
	"bugs": {
		"url": "https://github.com/sergeyfarin/retirement-planner/issues"
	},
	"keywords": [
		"retirement",
		"fire",
		"monte-carlo",
		"financial-independence",
		"svelte",
		"webassembly"
	],
	"private": true,
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"scripts": {
		"build:wasm": "cd rust-engine && wasm-pack build --target web",
		"dev": "pnpm run build:wasm && vite dev",
		"build": "pnpm run build:wasm && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run build:wasm && pnpm run test:blocklength && pnpm run test:unit -- --run",
		"test:blocklength": "node --test scripts/analyze-block-length.test.mjs",
		"data:retirement:import": "node scripts/import-retirement-market-data.mjs",
		"data:retirement:preprocess": "node scripts/preprocess-retirement-market-data.mjs",
		"data:retirement:refresh": "pnpm run data:retirement:import && pnpm run data:retirement:preprocess",
		"test:engines": "pnpm run build:wasm && vitest run --project server",
		"data:retirement:blocklength": "pnpm run test:blocklength && node scripts/analyze-block-length.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.1.1",
		"@vitest/browser-playwright": "4.1.10",
		"esbuild": "0.28.1",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.7.0",
		"playwright": "1.62.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.22",
		"rollup": "4.62.2",
		"rust-engine": "file:rust-engine/pkg",
		"svelte": "5.56.8",
		"svelte-check": "4.7.3",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.1.5",
		"vite-plugin-top-level-await": "1.6.0",
		"vite-plugin-wasm": "3.6.0",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "3.0.0"
	},
	"dependencies": {
		"plotly.js-cartesian-dist-min": "3.7.0"
	}
}
