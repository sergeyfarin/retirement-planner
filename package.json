{
	"name": "retirement-planner",
	"version": "0.0.1",
	"description": "Browser-based FIRE retirement planner: regime-switching Monte Carlo simulation with historical block bootstrapping, running in a Rust/WebAssembly engine.",
	"license": "AGPL-3.0-only",
	"author": "Sergey Farin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sergeyfarin/retirement-planner.git"
	},
	"homepage": "https://github.com/sergeyfarin/retirement-planner#readme",
	"bugs": {
		"url": "https://github.com/sergeyfarin/retirement-planner/issues"
	},
	"keywords": [
		"retirement",
		"fire",
		"monte-carlo",
		"financial-independence",
		"svelte",
		"webassembly"
	],
	"private": true,
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"scripts": {
		"build:wasm": "cd rust-engine && wasm-pack build --target web",
		"dev": "pnpm run build:wasm && vite dev",
		"build": "pnpm run build:wasm && vite build && pnpm run prepack",
		"build:root": "RETIREMENT_HOSTING=root pnpm run build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
		"prepare": "pnpm run i18n:compile && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run build:wasm && pnpm run test:blocklength && pnpm run test:unit -- --run",
		"test:blocklength": "node --test scripts/analyze-block-length.test.mjs",
		"data:retirement:import": "node scripts/import-retirement-market-data.mjs",
		"data:retirement:preprocess": "node scripts/preprocess-retirement-market-data.mjs",
		"data:retirement:refresh": "pnpm run data:retirement:import && pnpm run data:retirement:preprocess",
		"test:engines": "pnpm run build:wasm && vitest run --project server",
		"data:retirement:blocklength": "pnpm run test:blocklength && node scripts/analyze-block-length.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/package": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.6.5",
		"@vitest/browser-playwright": "5.0.5",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.25",
		"rollup": "4.65.1",
		"rust-engine": "file:rust-engine/pkg",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vite-plugin-top-level-await": "1.6.0",
		"vite-plugin-wasm": "3.6.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"plotly.js": "4.1.2"
	}
}
